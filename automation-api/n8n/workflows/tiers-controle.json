    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SPAT_AUTOMATION_API_URL || 'http://127.0.0.1:8088'}}/api/v1/tiers/doublons",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ nom: $json.payload.nom, nif: $json.payload.nif, stat: $json.payload.stat, idExclu: $json.payload.id || '' }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "a2b0c2d0-0006-4b06-9c06-000000000006",
      "name": "Vérifier les doublons",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        180
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const api = $input.first().json || {};\nconst doublons = Array.isArray(api.doublons) ? api.doublons : [];\nconst liste = doublons.map((d) => 'ID ' + (d && d.id != null ? d.id : '') + ' - ' + (d && d.nom != null ? d.nom : '')).join(' ; ');\nconst message = doublons.length > 0 ? 'Doublons detectes : ' + liste + '.' : '';\nreturn [{ json: { valide: true, ecrit: false, statut: doublons.length > 0 ? 'A_VERIFIER' : 'VALIDE', doublons: doublons, message: message } }];"
      },
      "id": "a2b0c2d0-0007-4b07-9c07-000000000007",
      "name": "Préparer la réponse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
