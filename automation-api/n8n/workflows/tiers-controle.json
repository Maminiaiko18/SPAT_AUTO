    {
      "parameters": {
        "jsCode": "const input = $input.first().json || {};\nconst body = input.body && typeof input.body === 'object' && !Array.isArray(input.body) ? input.body : input;\nconst errors = [];\nconst safe = body && typeof body === 'object' && !Array.isArray(body) ? body : {};\n\nif (body === null || typeof body !== 'object' || Array.isArray(body)) {\n  errors.push({ field: 'body', message: 'Le corps doit etre un objet JSON.' });\n}\n\nconst allowed = ['nom', 'type', 'nif', 'stat'];\nfor (const key of Object.keys(safe)) {\n  if (!allowed.includes(key)) errors.push({ field: key, message: 'Champ non autorise.' });\n}\n\nconst isText = (value) => typeof value === 'string' && value.trim().length > 0;\nconst isType = (value) => typeof value === 'string' && /^TC\\d{3}$/.test(value);\nconst isNif = (value) => typeof value === 'string' && /^\\d{10}$/.test(value);\nconst isStat = (value) => typeof value === 'string' && /^\\d{17}$/.test(value);\n\nif (!isText(safe.nom)) errors.push({ field: 'nom', message: 'Valeur texte non vide requise.' });\nif (!isType(safe.type)) errors.push({ field: 'type', message: 'Format attendu TC suivi de 3 chiffres.' });\nif (!isNif(safe.nif)) errors.push({ field: 'nif', message: 'Exactement 10 chiffres requis.' });\nif (!isStat(safe.stat)) errors.push({ field: 'stat', message: 'Exactement 17 chiffres requis.' });\n\nreturn [{ json: { ok: errors.length === 0, errors } }];"
      },
