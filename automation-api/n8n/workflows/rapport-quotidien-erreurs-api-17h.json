    {
      "parameters": {
        "operation": "execute",
        "query": "SELECT ERROR_AT, SERVICE_NAME, HTTP_METHOD, ENDPOINT, HTTP_STATUS, ERROR_CODE, SUMMARY\nFROM SPAT_CAPITAINERIE.SPATERP_API_ERROR_LOG\nWHERE ERROR_AT >= FROM_TZ(\n        CAST(TRUNC(CAST(SYSTIMESTAMP AT TIME ZONE 'Indian/Antananarivo' AS DATE)) AS TIMESTAMP),\n        'Indian/Antananarivo'\n      )\n  AND ERROR_AT < SYSTIMESTAMP\nORDER BY ERROR_AT",
        "options": {
          "autoCommit": true
        }
      },
      "type": "n8n-nodes-base.oracleDatabase",
      "typeVersion": 1,
      "position": [
        208,
        0
      ],
      "id": "bd36898a-6f43-4e2a-b75d-d6faaea82155",
      "name": "Execute SQL",
      "credentials": {
        "oracleDBApi": {
          "id": "eK4ZXn9Y48GviO4u",
          "name": "Oracle Database Credentials account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\nconst value = (row, upper, lower) => row[upper] ?? row[lower] ?? '';\nconst report = rows.map(row => {\n  const when = value(row, 'ERROR_AT', 'error_at');\n  const service = value(row, 'SERVICE_NAME', 'service_name');\n  const method = value(row, 'HTTP_METHOD', 'http_method');\n  const endpoint = value(row, 'ENDPOINT', 'endpoint');\n  const status = value(row, 'HTTP_STATUS', 'http_status');\n  const code = value(row, 'ERROR_CODE', 'error_code');\n  const summary = value(row, 'SUMMARY', 'summary');\n  return `${when} | ${service} | ${method} ${endpoint} | HTTP ${status} (${code}) | ${summary}`;\n});\nreturn [{ json: { count: rows.length, report: report.length ? report.join('\\n') : 'Aucune erreur API détectée aujourd’hui.' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
